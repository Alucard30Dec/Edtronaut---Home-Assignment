APP_NAME=Live Code Execution & Management API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/live_exec
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=code_execution
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_LIMIT_MB=128
PYTHON_RUNNER_EXECUTABLE=python3
